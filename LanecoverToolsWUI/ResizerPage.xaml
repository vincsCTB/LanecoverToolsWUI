<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="LanecoverToolsWUI.ResizerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:LanecoverToolsWUI"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">


    <ScrollViewer>
        <Grid Padding="10">
            <StackPanel>

                <Border
                    x:Name="FolderSettings"
                    Grid.Row="0"
                    Margin="0,0,0,10"
                    Padding="16"
                    Background="#2D2D2D"
                    BorderBrush="#3F3F3F"
                    BorderThickness="1"
                    CornerRadius="8"
                    VariableSizedWrapGrid.ColumnSpan="1">
                    <Border.Transitions>
                        <TransitionCollection>
                            <RepositionThemeTransition />
                        </TransitionCollection>
                    </Border.Transitions>
                    <Grid>
                        <StackPanel HorizontalAlignment="Left" Spacing="8">
                            <Button
                                x:Name="PickFolderButton"
                                Click="PickFolderButton_Click"
                                Content="Pick a folder" />
                            <TextBlock x:Name="PickedFolderTextBlock" Text="No folder picked" />
                        </StackPanel>
                        <StackPanel HorizontalAlignment="Right">
                            <Button
                                x:Name="RevertButton"
                                Click="RevertButton_Click"
                                Content="Revert to old Fruits" />
                        </StackPanel>
                    </Grid>
                </Border>

                <StackPanel Margin="10,0,0,10" Spacing="5">
                    <TextBlock
                        x:Name="AssetStatusTextBlock"
                        FontSize="12"
                        FontStyle="Italic" />
                </StackPanel>

                <Border
                    x:Name="ResizeSettings"
                    Margin="0,0,0,10"
                    Padding="16"
                    Background="#2D2D2D"
                    BorderBrush="#3F3F3F"
                    BorderThickness="1"
                    CornerRadius="8">
                    <StackPanel>
                        <Grid
                            x:Name="ResizePanel"
                            ColumnDefinitions="7*, 3*"
                            ColumnSpacing="12"
                            RowDefinitions="Auto, Auto"
                            RowSpacing="5">
                            <TextBlock
                                Grid.Row="0"
                                Grid.Column="0"
                                VerticalAlignment="Bottom"
                                Text="{x:Bind ResizeUnitHeader, Mode=OneWay}" />
                            <ComboBox
                                x:Name="PercentageSelector"
                                Grid.Row="1"
                                Grid.Column="0"
                                HorizontalAlignment="Stretch"
                                ItemsSource="{x:Bind DynamicResizeOptions, Mode=OneWay}"
                                SelectedItem="{x:Bind SelectedPercentage, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock
                                Grid.Row="0"
                                Grid.Column="1"
                                VerticalAlignment="Bottom"
                                Text="Unit Mode" />
                            <ComboBox
                                x:Name="UnitModeSelector"
                                Grid.Row="1"
                                Grid.Column="1"
                                Width="90"
                                ItemsSource="{x:Bind UnitModes}"
                                SelectedItem="{x:Bind SelectedUnitMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>

                        <MenuFlyoutSeparator Margin="0,10,0,10" />

                        <StackPanel x:Name="ResizeOptions" Spacing="5">
                            <CheckBox
                                VerticalContentAlignment="Center"
                                Content="Resize Overlays"
                                IsChecked="{x:Bind Settings.ResizeOverlaysCb, Mode=TwoWay}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Button
                    x:Name="ResizeButton"
                    Width="400"
                    Height="40"
                    Margin="0,10,0,0"
                    HorizontalAlignment="Center"
                    Click="ResizeButton_Click"
                    Content="Resize Image"
                    FontWeight="SemiBold"
                    IsEnabled="{x:Bind enablePath, Mode=OneWay}">
                    <Button.Resources>
                        <SolidColorBrush x:Key="ButtonBackground" Color="#9D4EDD" />
                        <SolidColorBrush x:Key="ButtonForeground" Color="#FFFFFF" />
                        <SolidColorBrush x:Key="ButtonBorderBrush" Color="#B57CFF" />

                        <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#7B2CBF" />
                        <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#FFFFFF" />
                        <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#9D4EDD" />

                        <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#5A189A" />
                        <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#E0B0FF" />
                        <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#5A189A" />

                        <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="#3D3D3D" />
                        <SolidColorBrush x:Key="ButtonForegroundDisabled" Color="#6E6E6E" />
                        <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="Transparent" />
                    </Button.Resources>

                    <Button.Transitions>
                        <TransitionCollection>
                            <RepositionThemeTransition />
                        </TransitionCollection>
                    </Button.Transitions>
                </Button>

                <StackPanel
                    x:Name="NoPathMessage"
                    Margin="0,5,0,5"
                    HorizontalAlignment="Center"
                    Visibility="Visible">
                    <TextBlock
                        x:Name="NoPathMessageText"
                        Foreground="Orange"
                        Text="You need to choose a Path to generate a Lanecover" />
                </StackPanel>

                <ItemsControl
                    x:Name="NotificationItemsControl"
                    Margin="0,5,0,0"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Top">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="8" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerTransitions>
                        <TransitionCollection>
                            <AddDeleteThemeTransition />
                        </TransitionCollection>
                    </ItemsControl.ItemContainerTransitions>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ContentPresenter Content="{Binding Notifications}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
