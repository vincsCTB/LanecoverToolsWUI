<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="LanecoverToolsWUI.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:LanecoverToolsWUI"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <StackPanel Padding="15" Spacing="12">

        <TextBlock
            Margin="5,0,0,5"
            FontSize="18"
            FontWeight="SemiBold"
            Text="Keyboard Shortcuts" />

        <Border
            Padding="16"
            Background="#2D2D2D"
            BorderBrush="#3F3F3F"
            BorderThickness="1"
            CornerRadius="8">

            <StackPanel Spacing="20">

                <StackPanel Spacing="8">
                    <TextBlock
                        FontWeight="Medium"
                        Foreground="DarkGray"
                        Text="Generate Lane" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ComboBox
                            x:Name="GenerateModifier1"
                            Width="105"
                            Header="Modifier 1"
                            ItemsSource="{x:Bind GenerateModifier1Data}"
                            SelectedItem="{x:Bind SelectedGMod1, Mode=TwoWay}"
                            SelectionChanged="Modifier_SelectionChanged" />

                        <ComboBox
                            x:Name="GenerateModifier2"
                            Width="105"
                            Header="Modifier 2"
                            ItemsSource="{x:Bind GenerateModifier2Data}"
                            SelectedItem="{x:Bind SelectedGMod2, Mode=TwoWay}"
                            SelectionChanged="Modifier_SelectionChanged" />

                        <ComboBox
                            x:Name="GenerateKey"
                            Width="85"
                            Header="Key"
                            SelectedItem="{x:Bind SelectedGKey, Mode=TwoWay}"
                            SelectionChanged="Modifier_SelectionChanged" />
                    </StackPanel>
                </StackPanel>

                <MenuFlyoutSeparator Margin="0,4" />

                <StackPanel Spacing="8">
                    <TextBlock
                        FontWeight="Medium"
                        Foreground="DarkGray"
                        Text="Revert Lane" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ComboBox
                            x:Name="RevertModifier1"
                            Width="105"
                            Header="Modifier 1"
                            ItemsSource="{x:Bind RevertModifier1Data}"
                            SelectedItem="{x:Bind SelectedRMod1, Mode=TwoWay}"
                            SelectionChanged="Modifier_SelectionChanged" />

                        <ComboBox
                            x:Name="RevertModifier2"
                            Width="105"
                            Header="Modifier 2"
                            ItemsSource="{x:Bind RevertModifier2Data}"
                            SelectedItem="{x:Bind SelectedRMod2, Mode=TwoWay}"
                            SelectionChanged="Modifier_SelectionChanged" />

                        <ComboBox
                            x:Name="RevertKey"
                            Width="85"
                            Header="Key"
                            SelectedItem="{x:Bind SelectedRKey, Mode=TwoWay}"
                            SelectionChanged="Modifier_SelectionChanged" />
                    </StackPanel>
                </StackPanel>

            </StackPanel>
        </Border>
    </StackPanel>
</Page>