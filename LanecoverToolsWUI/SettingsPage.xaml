<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="LanecoverToolsWUI.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:LanecoverToolsWUI"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Width="400">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel x:Name="Panel1" Grid.Row="0">
            <Border
                x:Name="GenerateLaneContainer"
                CornerRadius="10"
                Padding="20"
                Background="DimGray"
                Margin="5,0,5,15"
                BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Generate Lane Shortcut" Margin="0,0,0,10" />
                    <StackPanel Orientation="Horizontal">
                        <ComboBox
                                x:Name="GenerateModifier1"
                                Header="Modifier 1:"
                                Margin="0,0,10,0"
                                Width="100"
                                SelectedItem="{x:Bind SelectedGMod1, Mode=TwoWay}" 
                                ItemsSource="{x:Bind GenerateModifier1Data}"
                                SelectionChanged="Modifier_SelectionChanged"
                                />

                        <ComboBox
                                x:Name="GenerateModifier2"
                                Header="Modifier 2:"
                                Margin="0,0,10,0"
                                Width="100"
                                SelectedItem="{x:Bind SelectedGMod2, Mode=TwoWay}" 
                                ItemsSource="{x:Bind GenerateModifier2Data}"
                                SelectionChanged="Modifier_SelectionChanged"
                                />

                        <ComboBox
                        x:Name="GenerateKey"
                        Header="Key:"
                        Width="80"
                        SelectedItem="{x:Bind SelectedGKey, Mode=TwoWay}"
                        SelectionChanged="Modifier_SelectionChanged"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>

        <StackPanel x:Name="Panel2" Grid.Row="1">
            <Border
                x:Name="RevertLaneContainer"
                CornerRadius="10"
                Padding="20"
                Background="DimGray"
                Margin="5,0,5,15"
                BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Revert Lane Shortcut" Margin="0,0,0,10"/>
                    <StackPanel Orientation="Horizontal">
                        <ComboBox
                            x:Name="RevertModifier1"
                            Header="Modifier 1:"
                            Margin="0,0,10,0"
                            Width="100"
                            SelectedItem="{x:Bind SelectedRMod1, Mode=TwoWay}" 
                            ItemsSource="{x:Bind RevertModifier1Data}"
                            SelectionChanged="Modifier_SelectionChanged"
                            />

                        <ComboBox
                            x:Name="RevertModifier2"
                            Header="Modifier 2:"
                            Margin="0,0,10,0"
                            Width="100"
                            SelectedItem="{x:Bind SelectedRMod2, Mode=TwoWay}" 
                            ItemsSource="{x:Bind RevertModifier2Data}"
                            SelectionChanged="Modifier_SelectionChanged"
                            />

                        <ComboBox
                            x:Name="RevertKey"
                            Header="Key:"
                            Width="80"
                            SelectedItem="{x:Bind SelectedRKey, Mode=TwoWay}"
                            SelectionChanged="Modifier_SelectionChanged"/>    
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>

</Page>
